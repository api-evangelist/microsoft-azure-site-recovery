  "info": {
    "_postman_id": "af4cbd4a-70e3-46fe-abc2-40361a3035df",
    "name": "Azure Site Recovery REST RecoveryPlans API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Azure Site Recovery REST API provides management of disaster recovery for\nAzure VMs, on-premises VMs, and physical servers via Azure Resource Manager.\nSupports configuring replication, running test failovers, executing planned\nand unplanned failovers, and managing recovery plans on Recovery Services\nvaults. Authentication uses Azure AD OAuth 2.0 bearer tokens.\n\n\nContact Support:\n Name: Kin Lane\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
  }
